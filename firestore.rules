rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Historial de chat con UniBot (IA)
    match /ai_chats/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['role', 'text', 'sentAt'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }
    }

    // Deny all other access by default (ajustar según reglas existentes del proyecto)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
