rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['suspended']) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended == false;
    }

    // === UNIBOT AI CHAT HISTORY ===
    match /ai_chats/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['role', 'text', 'sentAt'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;

        // Permitir que el usuario borre su propio historial de UniBot
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    // ==============================

    match /user_history/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId
                         && notSuspended();
      match /{collection}/{docId} {
        allow read, write: if request.auth != null 
                           && request.auth.uid == userId
                           && notSuspended();
      }
    }

    match /routes_history/{routeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && notSuspended();
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.driverId && notSuspended()
      );
      allow delete: if false;
    }

    match /users/{userId} {
      allow list: if true;
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
         && request.resource.data.rating is number) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedAt'])
         && request.auth.token.email == 'admin.00@uceva.edu.co') ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /studentCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /routes/{routeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && notSuspended();
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.driverId && notSuspended()) ||
        request.auth.token.email == 'admin.00@uceva.edu.co' ||
        (
          notSuspended() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats', 'status'])
        )
      );
      allow delete: if request.auth != null && (
        (request.auth.uid == resource.data.driverId && notSuspended()) ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      match /requests/{requestId} {
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.passengerId
                      && notSuspended();
        allow read: if request.auth != null;
        allow update: if request.auth != null && notSuspended();
        allow delete: if false;
      }
    }

    match /cupo_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.passengerId
                    && notSuspended();
      allow update: if request.auth != null && notSuspended() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
    }

    match /notifications/{notifId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
                    && resource.data.toUserId == request.auth.uid;
      allow delete: if request.auth != null &&
                    resource.data.toUserId == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.raterId
                    && notSuspended();
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.sellerId
                    && notSuspended();
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.sellerId && notSuspended()) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerRating'])
         && request.resource.data.sellerRating is number) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
         && request.auth.token.email == 'admin.00@uceva.edu.co') ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      allow delete: if request.auth != null && (
        (request.auth.uid == resource.data.sellerId && notSuspended()) ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                    && request.auth.token.email == 'admin.00@uceva.edu.co';
    }

    match /publications/{pubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                    && request.auth.token.email == 'admin.00@uceva.edu.co';
    }

    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        resource.data.driverId == request.auth.uid ||
        resource.data.passengerId == request.auth.uid ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      allow update, delete: if request.auth != null && (
        resource.data.driverId == request.auth.uid ||
        resource.data.passengerId == request.auth.uid ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      match /messages/{msgId} {
        allow create: if request.auth != null;
        allow read: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if false;
      }
    }

    match /direct_chats/{chatId} {
      allow create: if request.auth != null;
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      allow delete: if request.auth != null && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        request.auth.token.email == 'admin.00@uceva.edu.co'
      );
      match /messages/{msgId} {
        allow create: if request.auth != null;
        allow read: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }

  }
}
