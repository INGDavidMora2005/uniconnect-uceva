# .env.example — Plantilla de variables de entorno requeridas por UniConnect.
#
# INSTRUCCIONES:
# 1. Copiar este archivo y renombrarlo como .env en la raíz del proyecto.
# 2. Completar cada variable con el valor real (pedírselo al líder técnico).
# 3. El archivo .env NUNCA debe commitearse al repositorio (.gitignore lo excluye).
#
# CÓMO USAR ESTAS VARIABLES EN FLUTTER:
# Las variables NO se cargan desde el archivo .env en runtime.
# Deben pasarse como --dart-define al compilar o ejecutar:
#
#   flutter run \
#     --dart-define=SHARED_PHONE_KEY=tu_valor_aqui
#
#   flutter build apk --release \
#     --dart-define=SHARED_PHONE_KEY=tu_valor_aqui
#
# En VS Code, configurar en .vscode/launch.json > args para no escribirlo
# cada vez (ver documentación interna del equipo).

# Clave AES-256 de 32 caracteres para cifrado simétrico compartido.
# Usada para cifrar campos que deben ser legibles entre distintos usuarios
# (ej: número de teléfono entre conductor y pasajero).
# IMPORTANTE: todos los builds deben usar exactamente el mismo valor.
SHARED_PHONE_KEY=REEMPLAZAR_CON_CLAVE_AES_256_DE_32_CARACTERES

# Gemini API Key para el asistente UniBot (AiBotService) y las recomendaciones
# de rutas y productos (AiRecommendationService).
# Obtener desde: https://aistudio.google.com/app/apikey
# IMPORTANTE: Restringir la key en Google Cloud Console al package
# com.uceva.uniconnect_app para evitar uso no autorizado.
GEMINI_API_KEY=REEMPLAZAR_CON_TU_GEMINI_API_KEY
